{
  "name": "knowflow",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vue-tsc -b && vite build --config vite.config.ts",
    "build:minitool": "vue-tsc -b && vite build --config vite.config.ts && node scripts/clean-minitool.mjs",
    "preview": "vite preview --config vite.config.ts",
    "type-check": "vue-tsc --noEmit",
    "test:render": "node scripts/smoke-render.mjs",
    "test:voice": "node scripts/run-voice.mjs",
    "test:cards": "node scripts/run-cards.mjs",
    "test:provider": "node scripts/run-provider.mjs",
    "test:srs": "node scripts/run-srs.mjs",
    "test:export": "node scripts/run-export.mjs",
    "test:search": "node scripts/run-search.mjs",
    "test:quest": "node scripts/run-quest.mjs",
    "test:orb": "node scripts/run-orb.mjs && node scripts/run-orb-render.mjs",
    "test:progress": "node scripts/run-progress.mjs",
    "build:packs": "node scripts/build-packs.mjs && node scripts/build-life-packs.mjs && node scripts/build-food-packs.mjs",
    "test:markdown": "node scripts/run-markdown.mjs",
    "test:packs": "node scripts/smoke-packs.mjs",
    "build:food": "node scripts/build-food-packs.mjs",
    "test:food": "node scripts/smoke-food.mjs && node scripts/run-food-logic.mjs",
    "test:food:logic": "node scripts/run-food-logic.mjs",
    "test:idiom-game": "node scripts/run-idiom-game.mjs",
    "test:pair-game": "node scripts/run-pair.mjs",
    "test:runner": "node scripts/run-runner.mjs",
    "table:words": "node scripts/export-word-table.mjs cet4",
    "build:food:materials": "node scripts/extract-materials.mjs",
    "test:idiom-page": "node scripts/run-idiom-page.mjs",
    "test:kitchen": "node scripts/run-kitchen.mjs",
    "build:food:seasons": "node scripts/extract-seasons.mjs",
    "test:wordlearn": "node scripts/run-wordlearn.mjs",
    "start": "node server.mjs",
    "serve:prod": "vite build --config vite.config.ts && node server.mjs",
    "table:junior": "node scripts/import-junior-words.mjs",
    "test:cleanup": "node scripts/run-cleanup.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "lucide-vue-next": "^0.454.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10"
  }
}
